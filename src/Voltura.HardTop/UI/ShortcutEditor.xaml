<UserControl x:Class="Voltura.HardTop.Ui.ShortcutEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Editor" Focusable="False">
  <Button x:Name="CaptureButton" Click="BeginCapture" LostKeyboardFocus="CaptureLostFocus" HorizontalContentAlignment="Left" Margin="0" Padding="12,7" MinHeight="36" AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), ElementName=Editor}">
    <TextBlock x:Name="Combination" TextWrapping="Wrap" />
  </Button>
</UserControl>